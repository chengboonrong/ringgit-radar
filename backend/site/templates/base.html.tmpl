{{define "base"}}<!doctype html>
<html lang="{{.Lang.HTMLLang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
<meta name="theme-color" content="#C8102E">
<link rel="icon" type="image/png" href="/site/favicon.png">
<link rel="apple-touch-icon" href="/site/icon-192.png">
<link rel="preload" href="/site/fonts/MPLUSRounded1c-Regular.woff2" as="font" type="font/woff2" crossorigin>
<style>
@font-face { font-family: "M PLUS Rounded 1c"; font-weight: 400; font-display: swap; src: url(/site/fonts/MPLUSRounded1c-Regular.woff2) format("woff2"); unicode-range: U+0020-007E, U+00A0-00FF, U+2010-2027; }
@font-face { font-family: "M PLUS Rounded 1c"; font-weight: 700; font-display: swap; src: url(/site/fonts/MPLUSRounded1c-Bold.woff2) format("woff2"); unicode-range: U+0020-007E, U+00A0-00FF, U+2010-2027; }
:root { color-scheme: light dark; --red: #C8102E; --bg: #EAEAEA; --card: #F8F8F8; --text: #1A1A1A; --muted: #5C5C5C; --line: #D2D2D2; }
@media (prefers-color-scheme: dark) { :root { --bg: #1B1B1D; --card: #2A2A2D; --text: #F2F2F2; --muted: #B4B4B8; --line: #3C3C40; } }
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.55 "M PLUS Rounded 1c", system-ui, sans-serif; overflow-wrap: anywhere; }
a { color: inherit; }
a:focus-visible, summary:focus-visible { outline: 3px solid #5A6BFF; outline-offset: 2px; border-radius: 6px; }
.top { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; max-width: 640px; margin: 0 auto; padding: 12px 16px; }
.brand { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; font-weight: 700; font-size: 18px; text-decoration: none; }
.brand img { border-radius: 8px; }
.sw { font-family: system-ui, sans-serif; font-size: 15px; color: var(--muted); }
.sw a { display: inline-block; min-width: 44px; min-height: 44px; padding: 10px 6px; text-align: center; }
.sw a[aria-current] { color: var(--text); font-weight: 700; text-decoration: none; }
main { max-width: 640px; margin: 0 auto; padding: 8px 16px 32px; }
h1 { font-size: clamp(28px, 7vw, 40px); line-height: 1.2; margin: 16px 0 12px; }
h2 { font-size: 22px; line-height: 1.3; margin: 0 0 12px; }
h3 { font-size: 17px; line-height: 1.35; margin: 0 0 4px; }
p { margin: 0 0 12px; }
.lead { font-size: 18px; }
.cta { display: grid; gap: 12px; margin: 24px 0 16px; }
.btn { display: flex; align-items: center; justify-content: center; min-height: 52px; padding: 12px 20px; border-radius: 12px; font-weight: 700; font-size: 17px; text-align: center; text-decoration: none; cursor: pointer; }
.primary { background: var(--red); color: #FFF; }
.secondary { background: var(--card); color: var(--text); border: 2px solid var(--line); }
.alt .note { margin: 6px 0 0; text-align: center; }
summary.btn { list-style: none; }
summary.btn::-webkit-details-marker { display: none; }
details ol { margin: 12px 0 8px; padding: 16px 16px 16px 36px; border-radius: 12px; background: var(--card); }
details li + li { margin-top: 6px; }
.note, .unofficial, .facts { color: var(--muted); font-size: 14px; }
.unofficial { margin-bottom: 24px; }
.shot { display: block; width: min(100%, 360px); height: auto; margin: 0 auto 16px; border-radius: 24px; box-shadow: 0 6px 24px rgb(0 0 0 / .18); }
.facts { text-align: center; margin-bottom: 32px; }
section { margin: 0 0 16px; padding: 20px; border-radius: 16px; background: var(--card); }
section ul, section ol { margin: 0; padding-left: 20px; }
section li + li { margin-top: 10px; }
.get { list-style: none; padding: 0; }
.qa + .qa { margin-top: 16px; }
.qa p { margin: 0; }
footer { max-width: 640px; margin: 0 auto; padding: 0 16px 40px; color: var(--muted); font-size: 14px; }
footer ul { display: flex; flex-wrap: wrap; gap: 0 20px; margin: 8px 0 0; padding: 0; list-style: none; }
footer li a { display: inline-block; min-height: 44px; padding: 10px 0; }
</style>
</head>
<body data-lang="{{.Lang.Code}}">
<header class="top">
<a class="brand" href="{{.Lang.Prefix}}/"><img src="/site/icon-192.png" alt="" width="36" height="36">Ringgit Radar</a>
<nav class="sw" aria-label="{{.T "langLabel"}}">{{range $i, $s := .Switch}}{{if $i}} · {{end}}<a href="{{$s.Href}}" hreflang="{{$s.HTMLLang}}" lang="{{$s.HTMLLang}}" data-lang="{{$s.Code}}"{{if $s.Current}} aria-current="page"{{end}}>{{$s.Label}}</a>{{end}}</nav>
</header>
<main>
{{template "main" .}}
</main>
<footer>
<p>{{.T "unofficial"}}</p>
<ul>
<li><a href="https://github.com/chengboonrong/ringgit-radar">{{.T "footerGitHub"}}</a></li>
<li><a href="/app/privacy">{{.T "footerPrivacy"}}</a></li>
<li><a href="/app/data-sources">{{.T "footerData"}}</a></li>
</ul>
</footer>
<script>
(function () {
  var ua = navigator.userAgent;
  var android = /Android/i.test(ua);
  var ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
  var cta = document.getElementById('cta');
  if (cta) {
    var open = document.getElementById('open'), droid = document.getElementById('android');
    if (android) {
      cta.insertBefore(droid, cta.firstChild);
      droid.querySelector('a').className = 'btn primary';
      open.className = 'btn secondary';
    } else if (ios) {
      droid.hidden = true;
      document.getElementById('iphone').hidden = false;
    }
  }
  // Only a real choice of language is carried into the app: the zh and ms pages, or the EN switch link.
  var lang = document.body.getAttribute('data-lang');
  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('a');
    if (!link) return;
    try {
      if (link.hasAttribute('data-lang')) {
        sessionStorage.setItem('rr.lang', link.getAttribute('data-lang'));
      } else if ((link.getAttribute('href') || '').indexOf('/app/') === 0) {
        var chosen = lang !== 'en' ? lang : (sessionStorage.getItem('rr.lang') === 'en' ? 'en' : null);
        if (chosen) localStorage.setItem('flutter.locale', JSON.stringify(chosen));
      }
    } catch (_) {}
  });
  var count = document.querySelector('[data-count]');
  if (count && window.fetch) {
    fetch('/v1/status/prices').then(function (r) { return r.ok ? r.json() : null; }).then(function (s) {
      if (s && Number.isInteger(s.product_count) && s.product_count > 0) count.textContent = s.product_count.toLocaleString('en-US');
    }).catch(function () {});
  }
})();
</script>
</body>
</html>
{{end}}
