{
  "@@locale": "en",
  "languageHeading": "Language",
  "@languageHeading": {
    "description": "Settings section heading above the language chips, about 20 characters"
  },
  "appLanguageSystem": "System",
  "@appLanguageSystem": {
    "description": "Language chip in Settings: follow the device language, about 10 characters"
  },
  "couldNotLoad": "{what, select, list{Couldn't load the list.} highlights{Couldn't load Highlights.} ranking{Couldn't load the ranking.} genres{Couldn't load genres.} status{Couldn't load data status.} game{Couldn't load this game.} other{Couldn't load this.}}",
  "@couldNotLoad": {
    "description": "First sentence of an error message in the middle of a page, saying which request failed. Followed by a second sentence saying why. Room for a full sentence.",
    "placeholders": {
      "what": {
        "type": "String"
      }
    }
  },
  "serverAnswered": "The server answered {status}.",
  "@serverAnswered": {
    "description": "Second sentence of an error message: the server replied with an HTTP error code (the number, e.g. 503). Room for a full sentence.",
    "placeholders": {
      "status": {
        "type": "int"
      }
    }
  },
  "serverUnreachable": "The Ringgit Radar server can't be reached.",
  "@serverUnreachable": {
    "description": "Second sentence of an error message: no connection to the app's server. 'Ringgit Radar' is the app's name, never translated. Room for a full sentence."
  },
  "unexpectedAnswer": "The answer was not in the expected shape.",
  "@unexpectedAnswer": {
    "description": "Second sentence of an error message: the server answered with data the app could not read. Room for a full sentence."
  },
  "somethingWentWrong": "Something went wrong.",
  "@somethingWentWrong": {
    "description": "Error message for a failure that is not a server request. Room for a full sentence."
  },
  "saleEnds": "Sale ends {dateTime}",
  "@saleEnds": {
    "description": "Line on a game page under the price: when the sale ends. dateTime is a date and time in Malaysia time, e.g. '16 Dec 2026, 11:59 pm'. About 35 characters plus the date.",
    "placeholders": {
      "dateTime": {
        "type": "String"
      }
    }
  },
  "percentOff": "{percent}% OFF",
  "@percentOff": {
    "description": "Red sale chip next to a price, e.g. '10% OFF'. Very tight: about 8 characters. Capitals in English as on the eShop.",
    "placeholders": {
      "percent": {
        "type": "int"
      }
    }
  },
  "itemsCount": "{count, plural, other{Items: {count}}}",
  "@itemsCount": {
    "description": "Small count above a list of games, e.g. 'Items: 7,827'. About 15 characters.",
    "placeholders": {
      "count": {
        "type": "int",
        "format": "decimalPattern"
      }
    }
  },
  "comingSoon": "Coming soon",
  "@comingSoon": {
    "description": "Stands where a price would be, for a game not out yet with no release date. About 14 characters, right-aligned on a card."
  },
  "priceUnavailable": "Price unavailable",
  "@priceUnavailable": {
    "description": "Stands where a price would be when the store gives none for a released game. About 18 characters, right-aligned on a card."
  }
}
